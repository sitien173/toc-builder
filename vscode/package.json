{
  "name": "toc-builder",
  "displayName": "TOC Builder",
  "description": "Generate temporary Markdeep HTML table-of-contents views for Markdown files.",
  "version": "0.1.0",
  "publisher": "toc-builder",
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tocBuilder.preview",
        "title": "TOC Builder: Open Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "tocBuilder.refresh",
        "title": "TOC Builder: Refresh Preview",
        "icon": "$(refresh)"
      },
      {
        "command": "tocBuilder.screenshot",
        "title": "TOC Builder: Capture Screenshot to Clipboard",
        "icon": "$(camera)"
      },
      {
        "command": "tocBuilder.setTemplate",
        "title": "TOC Builder: Set Custom Template..."
      },
      {
        "command": "tocBuilder.useDefaultTemplate",
        "title": "TOC Builder: Use Default Template"
      }
    ],
    "menus": {
      "webview/title": [
        {
          "command": "tocBuilder.refresh",
          "group": "navigation"
        },
        {
          "command": "tocBuilder.screenshot",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "TOC Builder",
      "properties": {
        "tocBuilder.templatePath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Template path, relative to the Markdown file's workspace folder or absolute."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@mariozechner/clipboard": "0.3.9",
    "playwright-core": "1.62.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0"
  }
}
