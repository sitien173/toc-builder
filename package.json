{
  "name": "toc-builder",
  "version": "0.1.2",
  "description": "Generate temporary Markdeep HTML table-of-contents views for Markdown files.",
  "type": "module",
  "files": [
    "README.md",
    "src/",
    "templates/"
  ],
  "bin": {
    "toc": "src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/cli.test.js test/clipboard.test.js test/render.test.js test/screenshot.test.js",
    "test:screenshot-integration": "node --test test/screenshot.browser.js",
    "test:markdeep-canary": "node --test test/markdeep.canary.js",
    "test:clipboard-smoke": "node --input-type=module -e \"import('./src/clipboard.js').then(({ copyImage }) => copyImage(Buffer.from('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII=', 'base64')))\""
  },
  "dependencies": {
    "@mariozechner/clipboard": "0.3.9",
    "open": "^11.0.0",
    "playwright-core": "1.62.1"
  }
}
